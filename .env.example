# TypeWav — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Ne jamais committer .env.local

# ──────────────────────────────────────────
# Supabase (optionnel — uniquement pour features premium)
# Créer un projet sur https://supabase.com
# ──────────────────────────────────────────

# Exposée au client (safe — RLS protège les données)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# JAMAIS exposée au client — server only (API Routes uniquement)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ──────────────────────────────────────────
# Stripe (Phase 4 uniquement)
# https://dashboard.stripe.com/apikeys
# ──────────────────────────────────────────

# Exposée au client (safe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# JAMAIS exposée au client — server only
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs des produits Stripe (créer dans le dashboard)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# ──────────────────────────────────────────
# App (optionnel)
# ──────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000
