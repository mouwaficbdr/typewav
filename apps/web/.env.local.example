# TypeWav — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Exposées côté client (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JAMAIS exposée côté client — server only (webhooks, admin)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Exposée côté client (Dashboard → Developers → API keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# JAMAIS exposée côté client — server only
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs des prix Stripe (Dashboard → Products)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# ─── Application ──────────────────────────────────────────────────────────────
# URL de base (utilisée dans les redirections Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3000
