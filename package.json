{
  "name": "typewav",
  "version": "0.0.1",
  "private": true,
  "description": "TypeWav — immersive musical typing experience",
  "scripts": {
    "dev": "pnpm --filter @typewav/web dev",
    "build": "pnpm --filter @typewav/web build",
    "start": "pnpm --filter @typewav/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0 --config eslint.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.20.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.8.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4"
}
